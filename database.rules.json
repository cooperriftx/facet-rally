{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !data.parent().child('players').child(data.child('host').val()).exists())",
          ".validate": "newData.hasChildren(['host', 'track', 'state']) && newData.child('host').val() === auth.uid && newData.child('track').isString() && newData.child('track').val().length <= 20"
        },
        "players": {
          "$uid": {
            ".write": "auth != null && auth.uid === $uid",
            ".validate": "newData.child('name').isString() && newData.child('name').val().length >= 1 && newData.child('name').val().length <= 16"
          }
        }
      }
    },
    "open": {
      ".read": true,
      "$code": {
        ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || !root.child('rooms').child($code).child('players').child(data.child('host').val()).exists())",
        ".validate": "newData.child('host').val() === auth.uid && newData.child('track').isString()"
      }
    }
  }
}
