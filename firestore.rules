rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // fastest time (ms) accepted per track: 60% of the track's medal target
    function minMs() {
      return {
        'meadow': 8880, 'dunes': 13920, 'canyon': 9060, 'spiral': 15480, 'monza': 32040,
        'summit': 10980, 'switchback': 16860, 'suzuka': 24720, 'frostbite': 14760, 'neon': 18960,
        'lava': 13080, 'cloud': 13500, 'needle': 15480, 'gauntlet': 18600, 'pt1': 9780,
        'pt4': 9540, 'cruise': 8520, 'esses': 10560, 'hairpins': 11880, 'mesa': 9480,
        'skyneedles': 9840, 'valley': 10560, 'coaster': 9780, 'slalom': 10440, 'overpass': 10320,
        'volcano': 11640, 'blackout': 11400
      };
    }
    function signedIn() { return request.auth != null; }
    function google() { return signedIn() && request.auth.token.email is string; }

    // cloud saves: one document per Google-signed-in player, readable and writable only by them
    match /saves/{uid} {
      allow read: if google() && request.auth.uid == uid;
      allow create, update: if google() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['data', 'at', 'v'])
        && request.resource.data.data is string && request.resource.data.data.size() < 900000
        && request.resource.data.at == request.time;
      allow delete: if false;
    }

    // shared custom tracks: anyone can read; the author can delete; plays and likes only go up by one
    match /tracks/{id} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'author', 'theme', 'width', 'pieces', 'uid', 'at', 'plays', 'likes'])
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 32
        && request.resource.data.author is string && request.resource.data.author.size() >= 1 && request.resource.data.author.size() <= 16
        && request.resource.data.theme is string && request.resource.data.theme.size() <= 12
        && request.resource.data.width in [8, 10, 12, 14]
        && request.resource.data.pieces is string && request.resource.data.pieces.size() >= 1 && request.resource.data.pieces.size() <= 400
        && request.resource.data.plays == 0 && request.resource.data.likes == 0
        && request.resource.data.at == request.time;
      allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['plays'])
            && request.resource.data.plays == resource.data.plays + 1)
          || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && request.resource.data.likes == resource.data.likes + 1
            && !exists(/databases/$(database)/documents/tracks/$(id)/likes/$(request.auth.uid))
            && existsAfter(/databases/$(database)/documents/tracks/$(id)/likes/$(request.auth.uid))));
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      match /likes/{uid} {
        allow read: if true;
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().size() == 0
          && getAfter(/databases/$(database)/documents/tracks/$(id)).data.likes == get(/databases/$(database)/documents/tracks/$(id)).data.likes + 1;
        allow update, delete: if false;
      }
    }

    match /boards/{track}/times/{uid} {
      allow read: if true;
      allow create, update: if request.auth != null && request.auth.uid == uid
        && track in minMs()
        && request.resource.data.keys().hasOnly(['name', 'ms', 'body', 'at'])
        && request.resource.data.ms is int
        && request.resource.data.ms >= minMs()[track]
        && request.resource.data.ms <= 600000
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 16
        && request.resource.data.body is string && request.resource.data.body.size() <= 12
        && request.resource.data.at == request.time
        && (resource == null || request.resource.data.ms < resource.data.ms);
      allow delete: if false;
    }
  }
}
